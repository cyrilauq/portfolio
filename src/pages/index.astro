---
import Layout from '@/layouts/Layout.astro'
import AppMenu from '@/components/globals/AppMenu.vue'
import AppButton from '@/components/globals/AppButton.vue'
import AppCard from '@/components/globals/AppCard.vue'
import SectionHeading from '@/components/globals/SectionHeading.vue'
import PresentationView from '@/views/PresentationView.vue'
import ProjectView from '@/views/ProjectView.vue'
import SkillsView from '@/views/SkillsView.vue'
import ExperiencesView from '@/views/ExperiencesView.vue'
import { contactLinks } from '@/data/contact'

const strengths = [
  {
    title: 'I pick things up fast',
    text: "I like learning new technologies and ways of working, so an unfamiliar tool or codebase doesn't stop me for long.",
  },
  {
    title: 'I ask before I build',
    text: "I'd rather ask a question early than spend a week building something the client didn't want.",
  },
]
---

<Layout>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-yellow-300 focus:px-4 focus:py-2 focus:text-gray-900"
  >
    Skip to content
  </a>
  <AppMenu />
  <main id="main" class="mx-auto max-w-5xl px-4 md:px-8">
    <PresentationView />

    <section id="strengths" class="py-16">
      <SectionHeading eyebrow="About me" title="How I work" />
      <div class="grid gap-6 md:grid-cols-2">
        {
          strengths.map((s) => (
            <AppCard>
              <h3 class="mb-2 text-lg font-semibold text-gray-100">{s.title}</h3>
              <p class="leading-relaxed">{s.text}</p>
            </AppCard>
          ))
        }
      </div>
    </section>

    <SkillsView />
    <ProjectView />
    <ExperiencesView />

    <section id="contact" class="py-24 text-center">
      <h2 class="text-3xl font-bold text-gray-100 md:text-4xl">Get in touch</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed">
        I'm looking for my next developer role. Email is the fastest way to reach me. My code is
        on GitHub, and my full background is on LinkedIn.
      </p>
      <ul class="mt-8 flex flex-wrap justify-center gap-4">
        {
          contactLinks.map((link) => (
            <li>
              <AppButton
                href={link.href}
                external={link.external}
                variant={link.label === 'Email' ? 'primary' : 'secondary'}
              >
                {link.label}
              </AppButton>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <footer class="border-t border-gray-700/60 py-6 text-center text-sm text-gray-400">
    © {new Date().getFullYear()} Cyril Auquier · Built with Astro, Vue and Tailwind CSS
  </footer>
</Layout>
